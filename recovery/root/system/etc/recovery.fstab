# Dynamic Partitions (Super)
# System-as-root: mount the "system" logical partition at the android root.
# TWRP/OrangeFox maps this entry to /system_root; declaring /system here makes
# it try to resolve a partition mounted at /system_root (which does not exist),
# producing "unable to update logical partition: /system_root".
system                  /                   ext4    ro,barrier=1    wait,logical
vendor                  /vendor             ext4    ro,barrier=1    wait,logical
product                 /product            ext4    ro,barrier=1    wait,logical
# NOTE: the logical partition name in super is "odm", not "my_odm".
odm                     /odm                ext4    ro,barrier=1    wait,logical,nofail
my_product              /my_product         ext4    ro      wait,logical,first_stage_mount,nofail
my_engineering          /my_engineering     ext4    ro      wait,logical,first_stage_mount,nofail
my_company              /my_company         ext4    ro      wait,logical,first_stage_mount,nofail
my_carrier              /my_carrier         ext4    ro      wait,logical,first_stage_mount,nofail
my_region               /my_region          ext4    ro      wait,logical,first_stage_mount,nofail
my_heytap               /my_heytap          ext4    ro      wait,logical,first_stage_mount,nofail
my_stock                /my_stock           ext4    ro      wait,logical,first_stage_mount,nofail
my_preload              /my_preload         ext4    ro      wait,logical,first_stage_mount,nofail

# Physical Partitions
/dev/block/by-name/para            /misc           emmc    defaults                                        defaults
/dev/block/by-name/md_udc          /metadata       ext4    noatime,nosuid,nodev,discard                    wait,check,formattable,first_stage_mount
/dev/block/by-name/cache           /cache          ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check,formattable,first_stage_mount
/dev/block/by-name/persist         /persist        emmc    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,noatime,nosuid,nodev
/dev/block/by-name/userdata        /data           f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,resgid=1065,inlinecrypt	wait,check,formattable,quota,latemount,resize,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity
